local StellarHubMenu = loadstring(game:HttpGet("https://raw.githubusercontent.com/ImNotFatBitch/uimenu/main/StellarhubMenu"))()
local Settings = loadstring(game:HttpGet("https://raw.githubusercontent.com/ImNotFatBitch/uimenu/main/StellarhubSettings"))()

local Window = StellarHubMenu:Create({
    Title = 'Slip.wtf',
    Size = UDim2.new(0, 400, 0, 300),
    Position = UDim2.new(0.5, 0, 0.5, 0),
    ShowOnCreate = true,
    PerformanceMode = false,
    TweenSpeed = 0.3,
    UnloadTotal = true,
    PlayerListEnabled = false,
    WatermarkEnabled = true,
    WatermarkText = 'Slip.wtf',
    CanChangeTitleWatermark = false,
    ObfuscateConfig = false,
    MobileLogo = 'rbxassetid://14768967526',
})

local Tabs = {
    Main = Window:AddTab('Main'),
    Visual = Window:AddTab('Visual'),
}

local SettingsSections = Settings:InitializeSettingsTab(Window, 'SlipHub', 'Script')

-- ==============================
-- AIMBOT MOBILE (Auto Lock)
-- ==============================
local LeftGroupBox = Tabs.Main:AddLeftGroupbox('Aimbot')

-- Aimbot Variables
local aimbotEnabled = false
local currentTarget = nil
local aimPart = "Head"
local aimFOV = 200
local aimTeamCheck = false
local aimWallCheck = false

-- Get players function
local function GetPlayers()
    local players = {}
    local localPlayer = game:GetService("Players").LocalPlayer
    for _, v in pairs(game:GetService("Players"):GetPlayers()) do
        if v ~= localPlayer then
            if not aimTeamCheck or v.Team ~= localPlayer.Team then
                table.insert(players, v)
            end
        end
    end
    return players
end

-- Get Closest Player to Center of Screen (Mobile)
local function GetClosestPlayerToCenter()
    local closestPlayer = nil
    local shortestDistance = aimFOV
    local centerScreen = Vector2.new(workspace.CurrentCamera.ViewportSize.X / 2, workspace.CurrentCamera.ViewportSize.Y / 2)
    
    for _, player in pairs(GetPlayers()) do
        if player.Character and player.Character:FindFirstChild(aimPart) then
            local part = player.Character[aimPart]
            local vector, onScreen = workspace.CurrentCamera:WorldToViewportPoint(part.Position)
            if onScreen then
                local distance = (centerScreen - Vector2.new(vector.X, vector.Y)).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestPlayer = player
                end
            end
        end
    end
    return closestPlayer
end

-- Wall Check
local function CanSee(target)
    if not aimWallCheck then return true end
    
    local origin = workspace.CurrentCamera.CFrame.Position
    local targetPart = target.Character and target.Character:FindFirstChild(aimPart)
    if not targetPart then return false end
    
    local direction = (targetPart.Position - origin).unit * (targetPart.Position - origin).Magnitude
    local ray = Ray.new(origin, direction)
    local hit, pos = workspace:FindPartOnRay(ray, game:GetService("Players").LocalPlayer.Character)
    
    if hit and not hit:IsDescendantOf(target.Character) then
        return false
    end
    return true
end

-- Auto Aimbot Loop (Mobile)
local function AutoAimbot()
    while aimbotEnabled and task.wait(0.016) do -- ~60 FPS
        if not aimbotEnabled then break end
        
        local target = GetClosestPlayerToCenter()
        
        if target and target.Character and target.Character:FindFirstChild(aimPart) and CanSee(target) then
            local part = target.Character[aimPart]
            local targetPos = workspace.CurrentCamera:WorldToViewportPoint(part.Position)
            local centerScreen = Vector2.new(workspace.CurrentCamera.ViewportSize.X / 2, workspace.CurrentCamera.ViewportSize.Y / 2)
            local currentPos = Vector2.new(targetPos.X, targetPos.Y)
            
            -- Move camera towards target
            local delta = currentPos - centerScreen
            if delta.Magnitude > 5 then
                game:GetService("Players").LocalPlayer.Character.Humanoid.CameraOffset = Vector3.new(0, 0, 0)
                workspace.CurrentCamera.CFrame = workspace.CurrentCamera.CFrame * CFrame.new(-delta.X / 200, -delta.Y / 200, 0)
            end
        end
    end
end

-- Aimbot Toggle
LeftGroupBox:AddToggle('AimbotEnabled', {
    Text = 'Enable Aimbot (Auto Lock)',
    Default = false,
    Tooltip = 'Automatically locks onto enemies',
    Callback = function(Value)
        aimbotEnabled = Value
        if Value then
            task.spawn(AutoAimbot)
        end
    end
})

-- Aim Part Dropdown
LeftGroupBox:AddDropdown('AimPart', {
    Text = 'Aim Part',
    Values = {'Head', 'HumanoidRootPart', 'UpperTorso'},
    Default = 1,
    Multi = false,
    Tooltip = 'Which body part to aim at',
    Callback = function(Value)
        aimPart = Value
    end
})

-- FOV Slider
LeftGroupBox:AddSlider('AimFOV', {
    Text = 'Aimbot FOV',
    Default = 200,
    Min = 50,
    Max = 500,
    Rounding = 0,
    Suffix = 'px',
    Tooltip = 'Field of view for auto lock',
    Callback = function(Value)
        aimFOV = Value
    end
})

-- Team Check
LeftGroupBox:AddToggle('TeamCheck', {
    Text = 'Team Check',
    Default = false,
    Tooltip = 'Ignore teammates',
    Callback = function(Value)
        aimTeamCheck = Value
    end
})

-- Wall Check
LeftGroupBox:AddToggle('WallCheck', {
    Text = 'Wall Check',
    Default = false,
    Tooltip = 'Only lock if visible',
    Callback = function(Value)
        aimWallCheck = Value
    end
})

