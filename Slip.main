local StellarHubMenu = loadstring(game:HttpGet("https://raw.githubusercontent.com/ImNotFatBitch/uimenu/main/StellarhubMenu"))()
local Settings = loadstring(game:HttpGet("https://raw.githubusercontent.com/ImNotFatBitch/uimenu/main/StellarhubSettings"))()

local Window = StellarHubMenu:Create({
    Title = 'Slip.wtf',
    Size = UDim2.new(0, 500, 0, 600),
    Position = UDim2.new(0.5, 0, 0.5, 0),
    ShowOnCreate = true,
    PerformanceMode = false,
    TweenSpeed = 0.3,
    UnloadTotal = true,
    PlayerListEnabled = false,
    WatermarkEnabled = true,
    WatermarkText = 'Slip.wtf',
    CanChangeTitleWatermark = false,
    ObfuscateConfig = false,
    MobileLogo = 'rbxassetid://14768967526',
})

local Tabs = {
    Main = Window:AddTab('Main'),
    Visual = Window:AddTab('Visual'),
}

local SettingsSections = Settings:InitializeSettingsTab(Window, 'SlipHub', 'Script')

-- ==============================
-- AIMBOT (Main Tab)
-- ==============================
local LeftGroupBox = Tabs.Main:AddLeftGroupbox('Aimbot Settings')

-- Aimbot Variables
local aimbotEnabled = false
local aimbotKey = "MB2"
local aimPart = "Head"
local aimFOV = 100
local aimSmoothness = 5
local aimTeamCheck = false
local aimWallCheck = false
local aimLock = false

-- Get players function
local function GetPlayers()
    local players = {}
    for _, v in pairs(game:GetService("Players"):GetPlayers()) do
        if v ~= game:GetService("Players").LocalPlayer then
            if not aimTeamCheck or v.Team ~= game:GetService("Players").LocalPlayer.Team then
                table.insert(players, v)
            end
        end
    end
    return players
end

-- Get Closest Player to Mouse
local function GetClosestPlayer()
    local mouse = game:GetService("Players").LocalPlayer:GetMouse()
    local closestPlayer = nil
    local shortestDistance = aimFOV

    for _, player in pairs(GetPlayers()) do
        if player.Character and player.Character:FindFirstChild(aimPart) then
            local part = player.Character[aimPart]
            local vector, onScreen = workspace.CurrentCamera:WorldToViewportPoint(part.Position)
            if onScreen then
                local distance = (Vector2.new(mouse.X, mouse.Y) - Vector2.new(vector.X, vector.Y)).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestPlayer = player
                end
            end
        end
    end
    return closestPlayer
end

-- Aimbot Function
local function DoAimbot()
    if not aimbotEnabled then return end
    
    local mouse = game:GetService("Players").LocalPlayer:GetMouse()
    local target = GetClosestPlayer()
    
    if target and target.Character and target.Character:FindFirstChild(aimPart) then
        local part = target.Character[aimPart]
        if aimWallCheck then
            local origin = workspace.CurrentCamera.CFrame.Position
            local direction = (part.Position - origin).unit * (part.Position - origin).Magnitude
            local ray = Ray.new(origin, direction)
            local hit, pos = workspace:FindPartOnRay(ray, game:GetService("Players").LocalPlayer.Character)
            if hit and not hit:IsDescendantOf(target.Character) then
                return
            end
        end
        
        local targetPos = workspace.CurrentCamera:WorldToViewportPoint(part.Position)
        if targetPos then
            local mousePos = Vector2.new(mouse.X, mouse.Y)
            local targetScreenPos = Vector2.new(targetPos.X, targetPos.Y)
            local delta = targetScreenPos - mousePos
            
            if aimSmoothness > 0 then
                mousemoverel(delta.X / aimSmoothness, delta.Y / aimSmoothness)
            else
                mousemoverel(delta.X, delta.Y)
            end
            
            if aimLock then
                task.wait()
                DoAimbot()
            end
        end
    end
end

-- Aimbot Toggle
LeftGroupBox:AddToggle('AimbotEnabled', {
    Text = 'Enable Aimbot',
    Default = false,
    Tooltip = 'Toggle aimbot on/off',
    Callback = function(Value)
        aimbotEnabled = Value
    end
})

-- Aimbot Keybind
LeftGroupBox:AddKeybind('AimbotKey', {
    Title = 'Aimbot Key',
    Default = 'MB2',
    Mode = 'Hold',
    Tooltip = 'Key to activate aimbot',
    Callback = function(Value)
        if Value and aimbotEnabled then
            DoAimbot()
        end
    end,
    ChangedCallback = function(New)
        aimbotKey = New
    end
})

-- Aim Part Dropdown
LeftGroupBox:AddDropdown('AimPart', {
    Text = 'Aim Part',
    Values = {'Head', 'HumanoidRootPart', 'Torso', 'UpperTorso'},
    Default = 1,
    Multi = false,
    Tooltip = 'Which body part to aim at',
    Callback = function(Value)
        aimPart = Value
    end
})

-- FOV Slider
LeftGroupBox:AddSlider('AimFOV', {
    Text = 'Aimbot FOV',
    Default = 100,
    Min = 50,
    Max = 300,
    Rounding = 0,
    Suffix = 'px',
    Tooltip = 'Field of view for aimbot detection',
    Callback = function(Value)
        aimFOV = Value
    end
})

-- Smoothness Slider
LeftGroupBox:AddSlider('AimSmoothness', {
    Text = 'Smoothness',
    Default = 5,
    Min = 1,
    Max = 20,
    Rounding = 0,
    Suffix = '',
    Tooltip = 'How smooth the aimbot moves (lower = faster)',
    Callback = function(Value)
        aimSmoothness = Value
    end
})

-- Additional Aimbot Options
local aimbotGroup = Tabs.Main:AddRightGroupbox('Advanced Options')

aimbotGroup:AddToggle('TeamCheck', {
    Text = 'Team Check',
    Default = false,
    Tooltip = 'Ignore teammates',
    Callback = function(Value)
        aimTeamCheck = Value
    end
})

aimbotGroup:AddToggle('WallCheck', {
    Text = 'Wall Check',
    Default = false,
    Tooltip = 'Only aim if target is visible',
    Callback = function(Value)
        aimWallCheck = Value
    end
})

aimbotGroup:AddToggle('AimLock', {
    Text = 'Aim Lock',
    Default = false,
    Tooltip = 'Continuously lock onto target',
    Callback = function(Value)
        aimLock = Value
    end
})

