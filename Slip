CreateFOVCircle()

RunService.RenderStepped:Connect(function()
    local cfg = GetConfig()
    
    UpdateFOVCircle()
    ApplySpeed()
    ApplyJumpPower()
    UpdateHeadESP()
    UpdateAntiAim()
    
    -- Fly
    if cfg.FlyEnabled and not Flying then
        StartFly()
    elseif not cfg.FlyEnabled and Flying then
        Flying = false
        if FlyBodyGyro then FlyBodyGyro:Destroy() end
        if FlyBodyVelocity then FlyBodyVelocity:Destroy() end
        local char = LocalPlayer.Character
        if char and char:FindFirstChildWhichIsA("Humanoid") then
            char:FindFirstChildWhichIsA("Humanoid").PlatformStand = false
        end
    end
    
    -- BHop
    if cfg.BHopEnabled then
        StartBHop()
    end
    
    -- Noclip
    if cfg.NoclipEnabled then
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
    
    -- AIMBOT AUTO-LOCK (NÃO PRECISA DE KEYBIND)
    if cfg.AimbotEnabled then
        local best = GetBestTarget()
        
        -- Sticky aim: mantém o mesmo alvo se ainda estiver vivo
        if cfg.StickyAim and CurrentTarget and IsAlive(CurrentTarget) then
            best = CurrentTarget
        else
            CurrentTarget = best
        end
        
        if CurrentTarget then
            local angle = GetAngleToTarget(CurrentTarget)
            if angle <= cfg.FOV then
                AimAtTarget(CurrentTarget)
                DoAutoShoot()
            end
        end
    else
        CurrentTarget = nil
    end
end)

