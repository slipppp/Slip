-- Funções auxiliares
local function GetCharacter(p) return p.Character end
local function GetHumanoid(p) local c = GetCharacter(p) return c and c:FindFirstChild("Humanoid") end
local function IsAlive(p) local h = GetHumanoid(p) return h and h.Health > 0 end

local function IsTeammate(p)
    local cfg = GetConfig()
    if not cfg.TeamCheck then return false end
    return LocalPlayer.Team and p.Team == LocalPlayer.Team
end

local function GetPart(p, partName)
    local c = GetCharacter(p)
    if not c then return nil end
    
    local part = c:FindFirstChild(partName)
    if part then return part end
    
    if partName == "Torso" then
        part = c:FindFirstChild("UpperTorso")
        if part then return part end
    end
    
    return c:FindFirstChild("HumanoidRootPart")
end

local function GetTargetPart(t)
    local cfg = GetConfig()
    local part = GetPart(t, cfg.HitPart)
    if not part then part = GetPart(t, "HumanoidRootPart") end
    return part
end

local function WorldToScreen(pos)
    local v, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(v.X, v.Y), on
end

local function GetViewportCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

local function GetAngleToTarget(t)
    local p = GetTargetPart(t)
    if not p then return math.huge end
    local pos, on = WorldToScreen(p.Position)
    if not on then return math.huge end
    return (pos - GetViewportCenter()).Magnitude
end

-- Predição
local function PredictPosition(t, pos)
    local cfg = GetConfig()
    if not cfg.PredictionEnabled then return pos end
    
    local root = GetPart(t, "HumanoidRootPart")
    if not root or root.Velocity.Magnitude < 0.1 then return pos end
    
    local lr = GetPart(LocalPlayer, "HumanoidRootPart")
    if not lr then return pos end
    
    local distance = (pos - lr.Position).Magnitude
    local travelTime = distance / 3000
    local strength = cfg.PredictStrength / 100
    
    travelTime = travelTime * strength
    travelTime = math.min(travelTime, 0.3)
    
    return pos + (root.Velocity * travelTime)
end

-- Shake
local function ApplyShake()
    local cfg = GetConfig()
    if cfg.ShakeValue <= 0 then return Vector2.zero end
    return Vector2.new(
        (math.random() - 0.5) * cfg.ShakeValue * 2,
        (math.random() - 0.5) * cfg.ShakeValue * 2
    )
end

-- Smooth Aim
local function SmoothAim(currentPos, targetPos)
    local cfg = GetConfig()
    local smooth = (cfg.SmoothnessX + cfg.SmoothnessY) / 2
    local smoothFactor = 1 / (smooth * 2)
    local delta = targetPos - currentPos
    return currentPos + delta * math.min(smoothFactor, 0.3)
end

-- Mira automática
local function AimAtTarget(t)
    local p = GetTargetPart(t)
    if not p then return end
    
    local pos = p.Position
    if GetConfig().PredictionEnabled then
        pos = PredictPosition(t, pos)
    end
    
    local shake = ApplyShake()
    pos = pos + Vector3.new(shake.X, shake.Y, 0)
    
    local currentCF = Camera.CFrame
    local targetCF = CFrame.lookAt(currentCF.Position, pos)
    local newCF = SmoothAim(currentCF, targetCF)
    Camera.CFrame = newCF
end

-- Melhor alvo
local function GetBestTarget()
    local cfg = GetConfig()
    local best = nil
    local bestAngle = cfg.FOV
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsAlive(p) and not IsTeammate(p) then
            local angle = GetAngleToTarget(p)
            if angle < bestAngle then
                bestAngle = angle
                best = p
            end
        end
    end
    return best
end

-- Auto Shoot
local function DoAutoShoot()
    local cfg = GetConfig()
    if not cfg.AutoShoot or not CurrentTarget then return end
    
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Tool")
    if tool then
        tool:Activate()
    end
end

-- FOV Circle
local function CreateFOVCircle()
    if FOVCircle and FOVCircle.Parent then FOVCircle:Destroy() end
    
    local sg = Instance.new("ScreenGui")
    sg.Name = "FOVCircleGUI"
    sg.Parent = game:GetService("CoreGui")
    sg.ResetOnSpawn = false
    
    FOVCircle = Instance.new("Frame")
    FOVCircle.Name = "FOVCircle"
    FOVCircle.BackgroundTransparency = 0.85
    FOVCircle.BorderSizePixel = 2
    FOVCircle.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    FOVCircle.Parent = sg
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = FOVCircle
end

local function UpdateFOVCircle()
    if not FOVCircle then CreateFOVCircle() end
    local cfg = GetConfig()
    
    if not cfg.ShowFOV or not cfg.AimbotEnabled then
        FOVCircle.Visible = false
        return
    end
    
    FOVCircle.Visible = true
    if cfg.FOVColor then
        FOVCircle.BorderColor3 = cfg.FOVColor
    end
    
    local fov = cfg.FOV
    FOVCircle.Size = UDim2.new(0, fov * 2, 0, fov * 2)
    FOVCircle.Position = UDim2.new(0.5, -fov, 0.5, -fov)
end

-- Head ESP
local function UpdateHeadESP()
    local cfg = GetConfig()
    if not cfg.HeadESP then
        for _, c in pairs(HeadESPCircles) do
            pcall(function() c:Destroy() end)
        end
        HeadESPCircles = {}
        return
    end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsAlive(p) then
            local head = GetPart(p, "Head")
            if head then
                local pos, on = WorldToScreen(head.Position)
                if on then
                    local circle = HeadESPCircles[p]
                    if not circle then
                        local sg = Instance.new("ScreenGui")
                        sg.Name = "HeadESP_" .. p.Name
                        sg.Parent = game:GetService("CoreGui")
                        sg.ResetOnSpawn = false
                        
                        circle = Instance.new("Frame")
                        circle.Size = UDim2.new(0, cfg.HeadESPSize, 0, cfg.HeadESPSize)
                        circle.BackgroundTransparency = 0.5
                        circle.BorderSizePixel = 2
                        circle.Parent = sg
                        
                        local corner = Instance.new("UICorner")
                        corner.CornerRadius = UDim.new(1, 0)
                        corner.Parent = circle
                        
                        HeadESPCircles[p] = circle
                    end
                    circle.Position = UDim2.new(0, pos.X - cfg.HeadESPSize/2, 0, pos.Y - cfg.HeadESPSize/2)
                    if cfg.HeadESPColor then
                        circle.BackgroundColor3 = cfg.HeadESPColor
                    end
                    circle.Size = UDim2.new(0, cfg.HeadESPSize, 0, cfg.HeadESPSize)
                    circle.Visible = true
                elseif HeadESPCircles[p] then
                    HeadESPCircles[p].Visible = false
                end
            end
        end
    end
end

-- Speed e Jump
local function ApplySpeedAndJump()
    local cfg = GetConfig()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if hum then
        hum.WalkSpeed = cfg.SpeedHackEnabled and cfg.WalkSpeed or 16
        hum.JumpPower = cfg.JumpPowerEnabled and cfg.JumpPowerValue or 50
    end
end

-- Noclip
local function UpdateNoclip()
    local cfg = GetConfig()
    local char = LocalPlayer.Character
    if not char then return end
    
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not cfg.NoclipEnabled
        end
    end
end

-- Anti-Aim
local function UpdateAntiAim()
    local cfg = GetConfig()
    if not cfg.AntiAimEnabled then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local yaw = 0
    if cfg.YawMode == "Backwards" then
        yaw = 180
    elseif cfg.YawMode == "Sideways" then
        yaw = 90
    elseif cfg.YawMode == "Spin Bot" then
        SpinAngle = (SpinAngle + cfg.SpinSpeed / 60) % 360
        yaw = SpinAngle
    elseif cfg.YawMode == "Jitter" then
        JitterTimer = JitterTimer + 0.1
        yaw = math.sin(JitterTimer) * 90
    end
    
    local pitch = 0
    if cfg.PitchMode == "Up" then
        pitch = -90
    elseif cfg.PitchMode == "Down" then
        pitch = 90
    elseif cfg.PitchMode == "Jitter" then
        JitterTimer = JitterTimer + 0.1
        pitch = math.sin(JitterTimer) * 45
    end
    
    root.CFrame = CFrame.new(root.Position) * CFrame.Angles(math.rad(pitch), math.rad(yaw), 0)
end

-- Inicializar
CreateFOVCircle()

-- Loop principal
RunService.RenderStepped:Connect(function()
    UpdateFOVCircle()
    ApplySpeedAndJump()
    UpdateNoclip()
    UpdateHeadESP()
    UpdateAntiAim()
    
    local cfg = GetConfig()
    
    if cfg.AimbotEnabled then
        local best = GetBestTarget()
        
        if cfg.StickyAim and CurrentTarget and IsAlive(CurrentTarget) then
            if GetAngleToTarget(CurrentTarget) <= cfg.FOV then
                best = CurrentTarget
            end
        end
        
        CurrentTarget = best
        
        if CurrentTarget then
            local angle = GetAngleToTarget(CurrentTarget)
            if angle <= cfg.FOV then
                AimAtTarget(CurrentTarget)
                DoAutoShoot()
            end
        end
    end
end)

