-- Main Loop
RunService.RenderStepped:Connect(function()
    UpdateConfig()
    UpdateHighlightColors()
    UpdateHighlights()
    UpdateFOVCircle()
    UpdateTargetTracer()
    UpdateSelfESP()
    UpdateHeadESP()
    UpdateAntiAim()
    
    if Config.AimbotEnabled then
        local best = GetBestTarget()
        CurrentTarget = best
        if CurrentTarget and GetAngleToTarget(CurrentTarget) <= Config.FOV then
            AimAtTarget(CurrentTarget)
            DoAutoShoot()
        end
    else
        CurrentTarget = nil
    end
end)

