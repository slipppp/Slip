        ShowFOV = f.ShowFOV or true,
        FOVColor = f.FOVColor,
        Deadzone = f.Deadzone or 5,
        ShakeValue = f.ShakeValue or 0,
        SmoothnessX = f.SmoothnessX or 8,
        SmoothnessY = f.SmoothnessY or 8,
        PredictionEnabled = f.PredictionEnabled or true,
        PredictMethod = f.PredictMethod or "Smart",
        PredictStrength = f.PredictStrength or 65,
        AutoShoot = f.AutoShoot or false,
        StickyAim = f.StickyAim or true,
        TeamCheck = f.TeamCheck or false,
        WallCheck = f.WallCheck or false,
        VisibleCheck = f.VisibleCheck or true,
        FlyEnabled = f.FlyEnabled or false,
        FlySpeed = f.FlySpeed or 50,
        SpeedHackEnabled = f.SpeedHackEnabled or false,
        WalkSpeed = f.WalkSpeed or 50,
        JumpPowerEnabled = f.JumpPowerEnabled or false,
        JumpPowerValue = f.JumpPowerValue or 100,
        NoclipEnabled = f.NoclipEnabled or false,
        BHopEnabled = f.BHopEnabled or false,
        AntiAimEnabled = f.AntiAimEnabled or false,
        PitchMode = f.PitchMode or "None",
        YawMode = f.YawMode or "None",
        SpinSpeed = f.SpinSpeed or 360,
        ESPEnable = f.ESPEnable or false,
        SelfESP = f.SelfESP or false,
