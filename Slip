-- Fly
local function StopFly()
    if not Flying then return end
    Flying = false
    local char = LocalPlayer.Character
    if char and char:FindFirstChildWhichIsA("Humanoid") then char:FindFirstChildWhichIsA("Humanoid").PlatformStand = false end
    if FlyBodyGyro then FlyBodyGyro:Destroy() FlyBodyGyro = nil end
    if FlyBodyVelocity then FlyBodyVelocity:Destroy() FlyBodyVelocity = nil end
end

local function StartFly()
    if Flying then StopFly() end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root or not hum then return end
    Flying = true
    local CONTROL = {F=0,B=0,L=0,R=0,Q=0,E=0}
    local lastControl = {F=0,B=0,L=0,R=0,Q=0,E=0}
    local speed = 0
    FlyBodyGyro = Instance.new("BodyGyro")
    FlyBodyVelocity = Instance.new("BodyVelocity")
    FlyBodyGyro.P = 9e4
    FlyBodyGyro.MaxTorque = Vector3.new(9e9,9e9,9e9)
    FlyBodyGyro.Parent = root
    FlyBodyVelocity.MaxForce = Vector3.new(9e9,9e9,9e9)
    FlyBodyVelocity.Parent = root
    hum.PlatformStand = true
    local flyInputDown = UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.W then CONTROL.F = Config.FlySpeed
        elseif input.KeyCode == Enum.KeyCode.S then CONTROL.B = -Config.FlySpeed
        elseif input.KeyCode == Enum.KeyCode.A then CONTROL.L = -Config.FlySpeed
        elseif input.KeyCode == Enum.KeyCode.D then CONTROL.R = Config.FlySpeed
        elseif input.KeyCode == Enum.KeyCode.E then CONTROL.Q = Config.FlySpeed * 2
        elseif input.KeyCode == Enum.KeyCode.Q then CONTROL.E = -Config.FlySpeed * 2 end
    end)
    local flyInputUp = UserInputService.InputEnded:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.W then CONTROL.F = 0
        elseif input.KeyCode == Enum.KeyCode.S then CONTROL.B = 0
        elseif input.KeyCode == Enum.KeyCode.A then CONTROL.L = 0
        elseif input.KeyCode == Enum.KeyCode.D then CONTROL.R = 0
        elseif input.KeyCode == Enum.KeyCode.E then CONTROL.Q = 0
        elseif input.KeyCode == Enum.KeyCode.Q then CONTROL.E = 0 end
    end)
    local flyConn = RunService.Heartbeat:Connect(function()
        if not Flying then return end
        local curChar = LocalPlayer.Character
        if not curChar or not curChar.Parent then StopFly() return end
        local hum = curChar:FindFirstChildWhichIsA("Humanoid")
        local root = curChar:FindFirstChild("HumanoidRootPart")
        if not root or not hum then return end
        local cam = workspace.CurrentCamera
        if CONTROL.L+CONTROL.R ~=0 or CONTROL.F+CONTROL.B ~=0 or CONTROL.Q+CONTROL.E ~=0 then speed=50
        elseif speed~=0 then speed=0 end
        if (CONTROL.L+CONTROL.R)~=0 or (CONTROL.F+CONTROL.B)~=0 or (CONTROL.Q+CONTROL.E)~=0 then
            FlyBodyVelocity.Velocity = ((cam.CFrame.LookVector*(CONTROL.F+CONTROL.B)) + ((cam.CFrame * CFrame.new(CONTROL.L+CONTROL.R, (CONTROL.F+CONTROL.B+CONTROL.Q+CONTROL.E)*0.2,0).p)-cam.CFrame.p))*speed
            lastControl = {F=CONTROL.F,B=CONTROL.B,L=CONTROL.L,R=CONTROL.R}
        elseif speed~=0 then
            FlyBodyVelocity.Velocity = ((cam.CFrame.LookVector*(lastControl.F+lastControl.B)) + ((cam.CFrame * CFrame.new(lastControl.L+lastControl.R, (lastControl.F+lastControl.B+CONTROL.Q+CONTROL.E)*0.2,0).p)-cam.CFrame.p))*speed
        else FlyBodyVelocity.Velocity = Vector3.new(0,0,0) end
        FlyBodyGyro.CFrame = cam.CFrame
    end)
    flyConn.flyInputDown = flyInputDown
    flyConn.flyInputUp = flyInputUp
end

-- Anti-Aim
local function UpdateAntiAim()
    if not Config.AntiAimEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local yaw = 0
    if Config.YawMode == "Backwards" then yaw = 180
    elseif Config.YawMode == "Sideways" then yaw = 90
    elseif Config.YawMode == "Spin" then SpinAngle = (SpinAngle + Config.SpinSpeed/60) % 360 yaw = SpinAngle end
    local pitch = 0
    if Config.PitchMode == "Up" then pitch = -90
    elseif Config.PitchMode == "Down" then pitch = 90 end
    root.CFrame = CFrame.new(root.Position) * CFrame.Angles(math.rad(pitch), math.rad(yaw), 0)
end

-- Self ESP
local function UpdateSelfESP()
    if not Config.SelfESP then if SelfESPCircle then SelfESPCircle:Destroy() SelfESPCircle = nil end return end
    local head = GetPart(LocalPlayer, "Head")
    if head then
        local pos, on = WorldToScreen(head.Position)
        if on then
            if not SelfESPCircle then
                local sg = Instance.new("ScreenGui")
                sg.Name = "SelfESP"
                sg.Parent = game:GetService("CoreGui")
                SelfESPCircle = Instance.new("Frame")
                SelfESPCircle.Size = UDim2.new(0, 30, 0, 30)
                SelfESPCircle.BackgroundTransparency = 0.5
                SelfESPCircle.BorderSizePixel = 2
                SelfESPCircle.Parent = sg
                local c = Instance.new("UICorner")
                c.CornerRadius = UDim.new(1, 0)
                c.Parent = SelfESPCircle
            end
            SelfESPCircle.Position = UDim2.new(0, pos.X - 15, 0, pos.Y - 15)
            SelfESPCircle.BackgroundColor3 = Config.SelfESPColor
            SelfESPCircle.Visible = true
        elseif SelfESPCircle then SelfESPCircle.Visible = false end
    end
end

-- Head ESP
local function UpdateHeadESP()
    if not Config.HeadESP then
        for _, c in pairs(HeadESPCircles) do if c then c:Destroy() end end
        HeadESPCircles = {} return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsAlive(p) and not IsTeammate(p) then
            local dist = GetDistanceToTarget(p)
            if dist <= Config.ESPDistance then
                local head = GetPart(p, "Head")
                if head then
                    local pos, on = WorldToScreen(head.Position)
                    if on then
                        local c = HeadESPCircles[p]
                        if not c then
                            local sg = Instance.new("ScreenGui")
                            sg.Name = "HeadESP_" .. p.Name
                            sg.Parent = game:GetService("CoreGui")
                            c = Instance.new("Frame")
                            c.Size = UDim2.new(0, Config.HeadESPSize, 0, Config.HeadESPSize)
                            c.BackgroundTransparency = 0.5
                            c.BorderSizePixel = 2
                            c.Parent = sg
                            local corner = Instance.new("UICorner")
                            corner.CornerRadius = UDim.new(1, 0)
                            corner.Parent = c
                            HeadESPCircles[p] = c
                        end
                        c.Position = UDim2.new(0, pos.X - Config.HeadESPSize/2, 0, pos.Y - Config.HeadESPSize/2)
                        c.BackgroundColor3 = Config.HeadESPColor
                        c.Visible = true
                    elseif HeadESPCircles[p] then HeadESPCircles[p].Visible = false end
                end
            end
        end
    end
end

-- ESP Box
local function UpdateESPBoxes()
    if not Config.ESPEnable then
        for _, box in pairs(ESPBoxes) do if box then box:Destroy() end end
        ESPBoxes = {} return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsAlive(p) and not IsTeammate(p) then
            local dist = GetDistanceToTarget(p)
            if dist <= Config.ESPDistance then
                local root = GetPart(p, "HumanoidRootPart") or GetPart(p, "Torso") or GetPart(p, "UpperTorso")
                if root then
                    local box = ESPBoxes[p]
                    if not box then
                        box = Instance.new("BoxHandleAdornment")
                        box.AlwaysOnTop = true
                        box.ZIndex = 10
                        box.Parent = GetCharacter(p)
                        ESPBoxes[p] = box
                    end
                    box.Adornee = root
                    box.Size = Vector3.new(3, 5, 2)
                    box.Color3 = Config.BoxColor
                    box.Transparency = 0.5
                    box.Visible = true
                end
            elseif ESPBoxes[p] then ESPBoxes[p].Visible = false end
        end
    end
end

-- BHop
local BHopConn = nil
local function StartBHop()
    if BHopConn then BHopConn:Disconnect() end
    if Config.BHopEnabled then
        BHopConn = RunService.RenderStepped:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            local hum = char:FindFirstChild("Humanoid")
            if not hum then return end
            if hum.FloorMaterial ~= Enum.Material.Air and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    end
end

-- Update Config
local function UpdateConfig()
    local f = Library.Flags
    Config.AimbotEnabled = f.AimbotEnabled or false
    Config.HitPart = f.HitPart or "Head"
    Config.AirPart = f.AirPart or "Head"
    Config.FOV = f.FOV or 90
    Config.ShowFOV = f.ShowFOV or false
    if f.FOVColor then Config.FOVColor = Color3.fromRGB(f.FOVColor.R*255,f.FOVColor.G*255,f.FOVColor.B*255) end
    Config.Deadzone = f.Deadzone or 5
    Config.ShakeValue = f.ShakeValue or 0
    Config.SmoothnessX = f.SmoothnessX or 5
    Config.SmoothnessY = f.SmoothnessY or 5
    Config.PredictionEnabled = f.PredictionEnabled or false
    Config.PredictMethod = f.PredictMethod or "Linear"
    Config.PredictStrength = f.PredictStrength or 50
    Config.AutoShoot = f.AutoShoot or false
    Config.DynamicFOV = f.DynamicFOV or false
    Config.TeamCheck = f.TeamCheck or false
    Config.WallCheck = f.WallCheck or false
    Config.FlyEnabled = f.FlyEnabled or false
    Config.FlySpeed = f.FlySpeed or 50
    Config.SpeedHackEnabled = f.SpeedHackEnabled or false
    Config.WalkSpeed = f.WalkSpeed or 50
    Config.JumpPowerEnabled = f.JumpPowerEnabled or false
    Config.JumpPowerValue = f.JumpPowerValue or 100
    Config.NoclipEnabled = f.NoclipEnabled or false
    Config.BHopEnabled = f.BHopEnabled or false
    Config.AntiAimEnabled = f.AntiAimEnabled or false
    Config.PitchMode = f.PitchMode or "None"
    Config.YawMode = f.YawMode or "None"
    Config.SpinSpeed = f.SpinSpeed or 360
    Config.ESPEnable = f.ESPEnable or false
    Config.SelfESP = f.SelfESP or false
    if f.SelfESPColor then Config.SelfESPColor = Color3.fromRGB(f.SelfESPColor.R*255,f.SelfESPColor.G*255,f.SelfESPColor.B*255) end
    Config.HeadESP = f.HeadESP or false
    if f.HeadESPColor then Config.HeadESPColor = Color3.fromRGB(f.HeadESPColor.R*255,f.HeadESPColor.G*255,f.HeadESPColor.B*255) end
    Config.HeadESPSize = f.HeadESPSize or 25
    Config.ESPDistance = f.ESPDistance or 999999
    if f.BoxColor then Config.BoxColor = Color3.fromRGB(f.BoxColor.R*255,f.BoxColor.G*255,f.BoxColor.B*255) end
    if f.NameColor then Config.NameColor = Color3.fromRGB(f.NameColor.R*255,f.NameColor.G*255,f.NameColor.B*255) end
    ApplySpeed()
    ApplyJumpPower()
    if Config.FlyEnabled then StartFly() else StopFly() end
    StartBHop()
end

-- Initialize
CreateFOVCircle()
ApplySpeed()
ApplyJumpPower()

-- Loops
RunService.RenderStepped:Connect(function()
    UpdateConfig()
    UpdateFOVCircle()
    UpdateSelfESP()
    UpdateHeadESP()
    UpdateESPBoxes()
    UpdateAntiAim()
    UpdateNoclip()
    if Config.AimbotEnabled then
        local best = GetBestTarget()
        CurrentTarget = best
        if CurrentTarget and GetAngleToTarget(CurrentTarget) <= Config.FOV then
            AimAtTarget(CurrentTarget)
            DoAutoShoot()
        end
    else CurrentTarget = nil end
end)

