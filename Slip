-- Pegar configuração atual
local function GetFlag(flagName)
    local success, result = pcall(function()
        return Library.Flags[flagName]
    end)
    if success then
        return result
    end
    return nil
end

local function GetConfig()
    return {
        AimbotEnabled = GetFlag("AimbotEnabled") or false,
        HitPart = GetFlag("HitPart") or "Head",
        AirPart = GetFlag("AirPart") or "Head",
        FOV = GetFlag("FOV") or 120,
        ShowFOV = GetFlag("ShowFOV") or true,
        FOVColor = GetFlag("FOVColor"),
        Deadzone = GetFlag("Deadzone") or 5,
        ShakeValue = GetFlag("ShakeValue") or 0,
        SmoothnessX = GetFlag("SmoothnessX") or 8,
        SmoothnessY = GetFlag("SmoothnessY") or 8,
        PredictionEnabled = GetFlag("PredictionEnabled") or true,
        PredictMethod = GetFlag("PredictMethod") or "Smart",
        PredictStrength = GetFlag("PredictStrength") or 65,
        AutoShoot = GetFlag("AutoShoot") or false,
        StickyAim = GetFlag("StickyAim") or true,
        TeamCheck = GetFlag("TeamCheck") or false,
        WallCheck = GetFlag("WallCheck") or false,
        FlyEnabled = GetFlag("FlyEnabled") or false,
        FlySpeed = GetFlag("FlySpeed") or 50,
        SpeedHackEnabled = GetFlag("SpeedHackEnabled") or false,
        WalkSpeed = GetFlag("WalkSpeed") or 50,
        JumpPowerEnabled = GetFlag("JumpPowerEnabled") or false,
        JumpPowerValue = GetFlag("JumpPowerValue") or 100,
        NoclipEnabled = GetFlag("NoclipEnabled") or false,
        BHopEnabled = GetFlag("BHopEnabled") or false,
        AntiAimEnabled = GetFlag("AntiAimEnabled") or false,
