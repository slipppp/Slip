-- Update FOV Circle
RunService.RenderStepped:Connect(function()
    if showFOV and aimbotEnabled then
        fovCircle.Visible = true
        fovCircle.Position = Vector2.new(Mouse.X, Mouse.Y)
        fovCircle.Radius = fovSize
    else
        fovCircle.Visible = false
    end
end)

-- Get closest player to mouse
function GetClosestPlayer()
    local closestDistance = fovSize
    local closestPlayer = nil
    local mousePos = Vector2.new(Mouse.X, Mouse.Y)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local character = player.Character
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                local screenPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                if onScreen then
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if distance < closestDistance then
                        closestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    
    return closestPlayer
end

-- Get target part
function GetTargetPart(player)
    local partName = targetPart
    if partName == "Random" then
        local parts = {"Head", "Torso", "HumanoidRootPart"}
        partName = parts[math.random(1, #parts)]
    end
    
    if player.Character and player.Character:FindFirstChild(partName) then
        return player.Character[partName]
    elseif player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        return player.Character.HumanoidRootPart
    end
    return nil
end

-- Get air part (for jumping enemies)
function GetAirPart(player)
    local partName = airPart
    if partName == "Random" then
        local parts = {"Head", "Torso", "HumanoidRootPart"}
        partName = parts[math.random(1, #parts)]
    end
    
    if player.Character and player.Character:FindFirstChild(partName) then
        return player.Character[partName]
    elseif player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        return player.Character.HumanoidRootPart
    end
    return nil
end

-- Calculate predicted position
function PredictPosition(target, velocity)
    local distance = (target.Position - Camera.CFrame.Position).Magnitude
    local timeToTarget = distance / 1000 -- bullet travel time estimate
    local predictedPos = target.Position + (velocity * timeToTarget * prediction)
    return predictedPos
end

-- Apply shake
function ApplyShake(originalPosition)
    if shakeValue > 0 then
        local shakeX = (math.random() - 0.5) * shakeValue
        local shakeY = (math.random() - 0.5) * shakeValue
        local shakeZ = (math.random() - 0.5) * shakeValue
        return originalPosition + Vector3.new(shakeX, shakeY, shakeZ)
    end
    return originalPosition
end

-- Smooth aim
function SmoothAim(currentPos, targetPos, smoothFactor)
    local delta = targetPos - currentPos
    return currentPos + delta * smoothFactor
end

-- Check dead zone
function IsInDeadZone(targetScreenPos, mousePos)
    local distance = (targetScreenPos - mousePos).Magnitude
    return distance < deadZone
end

-- Aimbot main loop
RunService.RenderStepped:Connect(function()
    if not aimbotEnabled then return end
    
    -- Check if user is pressing the keybind
    local keybindFlag = Library:GetFlag("AimbotKey")
    if keybindFlag then
        local target = GetClosestPlayer()
        if target then
            local part = GetTargetPart(target)
            if part then
                -- Check if target is in air
                local humanoid = target.Character:FindFirstChild("Humanoid")
                local isInAir = humanoid and humanoid:GetState() == Enum.HumanoidStateType.Jumping or humanoid:GetState() == Enum.HumanoidStateType.Freefall
                
                local targetPartToUse = part
                if isInAir then
                    targetPartToUse = GetAirPart(target) or part
                end
                
                -- Get target position with prediction
                local targetPos = targetPartToUse.Position
                local velocity = targetPartToUse.Velocity
                local predictedPos = PredictPosition(targetPartToUse, velocity)
                local finalPos = ApplyShake(predictedPos)
                
                -- Convert to screen position
                local screenPos, onScreen = Camera:WorldToViewportPoint(finalPos)
                
                if onScreen then
                    local mousePos = Vector2.new(Mouse.X, Mouse.Y)
                    local targetScreenPos = Vector2.new(screenPos.X, screenPos.Y)
                    
                    -- Check dead zone
                    if IsInDeadZone(targetScreenPos, mousePos) then
                        return
                    end
                    
                    -- Apply smooth aim
                    local newMousePos = SmoothAim(mousePos, targetScreenPos, smoothness)
                    
                    -- Move mouse
                    mousemoverel(newMousePos.X - mousePos.X, newMousePos.Y - mousePos.Y)
                end
            end
        end
    end
end)

