    }
end

-- Funções auxiliares
local function GetCharacter(p) return p.Character end
local function GetHumanoid(p) local c = GetCharacter(p) return c and c:FindFirstChild("Humanoid") end
local function IsAlive(p) local h = GetHumanoid(p) return h and h.Health > 0 end

local function IsTeammate(p)
    local cfg = GetConfig()
    if not cfg.TeamCheck then return false end
    return LocalPlayer.Team and p.Team == LocalPlayer.Team
end

local function IsVisible(part)
    local cfg = GetConfig()
    if not cfg.VisibleCheck then return true end
    local origin = Camera.CFrame.Position
    local ray = Ray.new(origin, (part.Position - origin).Unit * (part.Position - origin).Magnitude)
    local hit, pos = workspace:FindPartOnRay(ray, LocalPlayer.Character)
    return hit == part or hit == nil
end

local function IsJumping(p)
    local h = GetHumanoid(p)
    if not h then return false end
    local s = h:GetState()
    return s == Enum.HumanoidStateType.Jumping or s == Enum.HumanoidStateType.Freefall
end

local function GetPart(p, partName)
    local c = GetCharacter(p)
    if not c then return nil end
    
    local mapping = {
        Head = {"Head"},
        Torso = {"Torso", "UpperTorso"},
        HumanoidRootPart = {"HumanoidRootPart"},
        ["Left Arm"] = {"Left Arm", "LeftHand"},
        ["Right Arm"] = {"Right Arm", "RightHand"},
        ["Left Leg"] = {"Left Leg", "LeftFoot"},
        ["Right Leg"] = {"Right Leg", "RightFoot"}
    }
    
    local names = mapping[partName] or {partName}
    for _, name in ipairs(names) do
        local part = c:FindFirstChild(name)
        if part then return part end
    end
    return nil
end

local function GetTargetPart(t)
    local cfg = GetConfig()
    local name = cfg.HitPart
    if IsJumping(t) and cfg.AirPart ~= "None" then
        name = cfg.AirPart
    end
    return GetPart(t, name) or GetPart(t, "HumanoidRootPart") or GetPart(t, "Torso") or GetPart(t, "UpperTorso")
end

local function WorldToScreen(pos)
    local v, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(v.X, v.Y), on
end

local function GetViewportCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

local function GetAngleToTarget(t)
    local p = GetTargetPart(t)
    if not p then return math.huge end
    local pos, on = WorldToScreen(p.Position)
    if not on then return math.huge end
    local center = GetViewportCenter()
    return (pos - center).Magnitude
end

-- Predição
local function PredictPosition(t, pos)
    local cfg = GetConfig()
    if not cfg.PredictionEnabled then return pos end
    
    local root = GetPart(t, "HumanoidRootPart") or GetPart(t, "Torso") or GetPart(t, "UpperTorso")
    if not root or root.Velocity.Magnitude < 0.1 then return pos end
    
    local lr = GetPart(LocalPlayer, "HumanoidRootPart") or GetPart(LocalPlayer, "Torso") or GetPart(LocalPlayer, "UpperTorso")
    if not lr then return pos end
    
    local distance = (pos - lr.Position).Magnitude
    local bulletSpeed = 3000
    local travelTime = distance / bulletSpeed
    local strength = cfg.PredictStrength / 100
    
    if cfg.PredictMethod == "Velocity" then
        travelTime = travelTime * (root.Velocity.Magnitude / 50)
    elseif cfg.PredictMethod == "Distance" then
        travelTime = travelTime * (distance / 100)
    elseif cfg.PredictMethod == "Smart" then
        local speedFactor = math.clamp(root.Velocity.Magnitude / 100, 0.5, 2)
        travelTime = travelTime * speedFactor
    end
    
    travelTime = travelTime * strength
    travelTime = math.min(travelTime, 0.3)
    
    return pos + (root.Velocity * travelTime)
end

-- Shake
local function ApplyShake()
    local cfg = GetConfig()
    if cfg.ShakeValue <= 0 then return Vector2.zero end
    return Vector2.new(
        (math.random() - 0.5) * cfg.ShakeValue * 2,
        (math.random() - 0.5) * cfg.ShakeValue * 2
    )
end

-- Smooth Aim
local function SmoothAim(currentPos, targetPos)
    local cfg = GetConfig()
    local smoothX = cfg.SmoothnessX
    local smoothY = cfg.SmoothnessY
    local smoothFactor = 1 / ((smoothX + smoothY) / 2)
    local delta = targetPos - currentPos
    return currentPos + delta * math.min(smoothFactor / 10, 0.5)
end

-- Mira automática (AUTO-LOCK)
local function AimAtTarget(t)
    local p = GetTargetPart(t)
    if not p then return end
    
    local pos = p.Position
    if GetConfig().PredictionEnabled then
        pos = PredictPosition(t, pos)
    end
    
    local shake = ApplyShake()
    pos = pos + Vector3.new(shake.X, shake.Y, 0)
    
    -- Verifica deadzone
    local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
    if onScreen then
        local center = GetViewportCenter()
        local currentScreenPos = Vector2.new(screenPos.X, screenPos.Y)
        local distanceToCenter = (currentScreenPos - center).Magnitude
        
        if distanceToCenter < GetConfig().Deadzone then
            return -- Dentro da deadzone, não mexe
        end
    end
    
    -- Calcula novo CFrame da câmera
    local currentCF = Camera.CFrame
    local targetCF = CFrame.lookAt(currentCF.Position, pos)
    
    -- Aplica smooth
    local newCF = SmoothAim(currentCF, targetCF)
    Camera.CFrame = newCF
end

-- Melhor alvo (mais próximo do centro da tela)
local function GetBestTarget()
    local cfg = GetConfig()
    local best = nil
    local bestAngle = cfg.FOV
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsAlive(p) and not IsTeammate(p) then
            local targetPart = GetTargetPart(p)
            if targetPart and (not cfg.WallCheck or IsVisible(targetPart)) then
                local angle = GetAngleToTarget(p)
                if angle < bestAngle then
                    bestAngle = angle
                    best = p
                end
            end
        end
    end
    return best
end

-- Auto Shoot
local function DoAutoShoot()
    local cfg = GetConfig()
    if not cfg.AutoShoot or not CurrentTarget then return end
    if GetAngleToTarget(CurrentTarget) <= cfg.FOV then
        local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Tool")
        if tool then
            tool:Activate()
        end
    end
end

-- FOV Circle
local function CreateFOVCircle()
    if FOVCircle then FOVCircle:Destroy() end
    local sg = Instance.new("ScreenGui")
    sg.Name = "FOVCircle"
    sg.Parent = game:GetService("CoreGui")
    FOVCircle = Instance.new("Frame")
    FOVCircle.BackgroundTransparency = 0.7
    FOVCircle.BorderSizePixel = 2
    FOVCircle.Parent = sg
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = FOVCircle
end

local function UpdateFOVCircle()
    if not FOVCircle then return end
    local cfg = GetConfig()
    if not cfg.ShowFOV or not cfg.AimbotEnabled then
        FOVCircle.Visible = false
        return
    end
    FOVCircle.Visible = true
    FOVCircle.BorderColor3 = cfg.FOVColor or Color3.fromRGB(255, 0, 0)
    local fov = cfg.FOV
    FOVCircle.Size = UDim2.new(0, fov * 2, 0, fov * 2)
    FOVCircle.Position = UDim2.new(0.5, -fov, 0.5, -fov)
end

