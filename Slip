-- SUPORTE R15 E R6
local function GetPart(p, partName)
    local c = p.Character
    if not c then return nil end
    
    local mapping = {
        Head = {"Head"},
        Torso = {"Torso", "UpperTorso"},
        HumanoidRootPart = {"HumanoidRootPart"},
        ["Left Arm"] = {"Left Arm", "LeftHand"},
        ["Right Arm"] = {"Right Arm", "RightHand"},
        ["Left Leg"] = {"Left Leg", "LeftFoot"},
        ["Right Leg"] = {"Right Leg", "RightFoot"}
    }
    
    local names = mapping[partName] or {partName}
    for _, name in ipairs(names) do
        local part = c:FindFirstChild(name)
        if part then return part end
    end
    return nil
end

local function GetCharacter(p) return p.Character end
local function GetHumanoid(p) local c = GetCharacter(p) return c and c:FindFirstChild("Humanoid") end
local function IsAlive(p) local h = GetHumanoid(p) return h and h.Health > 0 end

local function IsJumping(p)
    local h = GetHumanoid(p)
    if not h then return false end
    local s = h:GetState()
    return s == Enum.HumanoidStateType.Jumping or s == Enum.HumanoidStateType.Freefall
end

local function GetTargetPart(t)
    local name = Config.HitPart
    if IsJumping(t) and Config.AirPart ~= "None" then
        name = Config.AirPart
    end
    local p = GetPart(t, name) or GetPart(t, "HumanoidRootPart") or GetPart(t, "Torso") or GetPart(t, "UpperTorso")
    return p
end

local function WorldToScreen(pos)
    local v, on = Camera:WorldToScreenPoint(pos)
    return Vector2.new(v.X, v.Y), on
end

local function GetViewportCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

local function GetAngleToTarget(t)
    local p = GetTargetPart(t)
    if not p then return math.huge end
    local pos, on = WorldToScreen(p.Position)
    if not on then return math.huge end
    return (pos - GetViewportCenter()).Magnitude
end

local function GetDistanceToTarget(t)
    local p = GetTargetPart(t)
    local lp = GetPart(LocalPlayer, "HumanoidRootPart") or GetPart(LocalPlayer, "Torso") or GetPart(LocalPlayer, "UpperTorso")
    if not p or not lp then return 9999 end
    return (p.Position - lp.Position).Magnitude
end

-- FOV Circle
local function CreateFOVCircle()
    if FOVCircle then FOVCircle:Destroy() end
    local sg = Instance.new("ScreenGui")
    sg.Name = "FOVCircle"
    sg.Parent = game:GetService("CoreGui")
    FOVCircle = Instance.new("Frame")
    FOVCircle.BackgroundTransparency = 0.7
    FOVCircle.BorderSizePixel = 2
    FOVCircle.BorderColor3 = Color3.fromRGB(255, 0, 0)
    FOVCircle.Parent = sg
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = FOVCircle
end

local function UpdateFOVCircle()
    if not FOVCircle then return end
    local fov = Config.FOV
    if Config.DynamicFOV and CurrentTarget then
        local dist = GetDistanceToTarget(CurrentTarget)
        fov = math.clamp(Config.FOV * (1 - (dist / 500)), 30, Config.FOV)
    end
    FOVCircle.Size = UDim2.new(0, fov * 2, 0, fov * 2)
    FOVCircle.Position = UDim2.new(0.5, -fov, 0.5, -fov)
end

-- Prediction
local function PredictPosition(t, pos)
    if not Config.PredictionEnabled then return pos end
    local root = GetPart(t, "HumanoidRootPart") or GetPart(t, "Torso") or GetPart(t, "UpperTorso")
    if not root or root.Velocity.Magnitude < 0.1 then return pos end
    local lr = GetPart(LocalPlayer, "HumanoidRootPart") or GetPart(LocalPlayer, "Torso") or GetPart(LocalPlayer, "UpperTorso")
    if not lr then return pos end
    local dist = (pos - lr.Position).Magnitude
    local travel = dist / 3000 * (Config.PredictStrength / 100)
    if Config.PredictMethod == "Velocity" then
        travel = travel * (root.Velocity.Magnitude / 50)
    elseif Config.PredictMethod == "Smart" then
        travel = travel * (1 + (root.Velocity.Magnitude / 100))
    end
    travel = math.min(travel, 0.3)
    return pos + (root.Velocity * travel)
end

-- Shake
local function ApplyShake()
    if Config.ShakeValue <= 0 then return Vector2.zero end
    return Vector2.new((math.random() - 0.5) * Config.ShakeValue * 2, (math.random() - 0.5) * Config.ShakeValue * 2)
end

-- Aim at Target
local function AimAtTarget(t)
    local p = GetTargetPart(t)
    if not p then return end
    
    local pos = p.Position
    if Config.PredictionEnabled then pos = PredictPosition(t, pos) end
    
    local shake = ApplyShake()
    pos = pos + Vector3.new(shake.X, shake.Y, 0)
    
    local cur = Camera.CFrame
    local target = CFrame.lookAt(cur.Position, pos)
    local diff = math.deg(math.acos(math.clamp(cur.LookVector:Dot(target.LookVector), -1, 1)))
    
    if diff < Config.Deadzone then return end
    
    if Config.Smoothness <= 0 then
        Camera.CFrame = target
    else
        local alpha = 1 / Config.Smoothness
        Camera.CFrame = cur:Lerp(target, alpha / 10)
    end
end

-- Best Target
local function GetBestTarget()
    local best = nil
    local bestAngle = Config.FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsAlive(p) then
            local angle = GetAngleToTarget(p)
            if angle < bestAngle then
                bestAngle = angle
                best = p
            end
        end
    end
    return best
end

-- Auto Shoot
local function DoAutoShoot()
    if not Config.AutoShoot or not CurrentTarget then return end
    if GetAngleToTarget(CurrentTarget) <= Config.FOV then
        local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Tool")
        if tool then tool:Activate() end
    end
end

-- Target Tracer
local function UpdateTargetTracer()
    if not Config.TargetTracer or not CurrentTarget then
        if TargetLine then TargetLine:Destroy() end
        return
    end
    local p = GetTargetPart(CurrentTarget)
    if not p then return end
    local pos, on = WorldToScreen(p.Position)
    if not on then return end
    local center = GetViewportCenter()
    pcall(function()
        if TargetLine then TargetLine:Destroy() end
        local line = Drawing.new("Line")
        line.From = center
        line.To = pos
        line.Color = Color3.fromRGB(255, 0, 0)
        line.Thickness = 2
        line.Transparency = 0.5
        line.Visible = true
        TargetLine = line
    end)
end

-- Self ESP (bola na própria cabeça)
local function UpdateSelfESP()
    local flags = Library.Flags
    if not flags.SelfESP then
        if SelfESPCircle then SelfESPCircle:Destroy() SelfESPCircle = nil end
        return
    end
    local head = GetPart(LocalPlayer, "Head")
    if head then
        local pos, on = WorldToScreen(head.Position)
        if on then
            if not SelfESPCircle then
                local sg = Instance.new("ScreenGui")
                sg.Name = "SelfESP"
                sg.Parent = game:GetService("CoreGui")
                SelfESPCircle = Instance.new("Frame")
                SelfESPCircle.Size = UDim2.new(0, 30, 0, 30)
                SelfESPCircle.BackgroundTransparency = 0.5
                SelfESPCircle.BorderSizePixel = 2
                SelfESPCircle.Parent = sg
                local c = Instance.new("UICorner")
                c.CornerRadius = UDim.new(1, 0)
                c.Parent = SelfESPCircle
            end
            SelfESPCircle.Position = UDim2.new(0, pos.X - 15, 0, pos.Y - 15)
            SelfESPCircle.BackgroundColor3 = Color3.fromRGB(flags.SelfESPColor.R * 255, flags.SelfESPColor.G * 255, flags.SelfESPColor.B * 255)
            SelfESPCircle.Visible = true
        elseif SelfESPCircle then
            SelfESPCircle.Visible = false
        end
    end
end

-- Head ESP (bola 2D na cabeça do inimigo)
local function UpdateHeadESP()
    local flags = Library.Flags
    if not flags.HeadESP then
        for _, c in pairs(HeadESPCircles) do if c then c:Destroy() end end
        HeadESPCircles = {}
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsAlive(p) then
            local head = GetPart(p, "Head")
            if head then
                local pos, on = WorldToScreen(head.Position)
                if on then
                    local c = HeadESPCircles[p]
                    if not c then
                        local sg = Instance.new("ScreenGui")
                        sg.Name = "HeadESP_" .. p.Name
                        sg.Parent = game:GetService("CoreGui")
                        c = Instance.new("Frame")
                        c.Size = UDim2.new(0, flags.HeadESPSize, 0, flags.HeadESPSize)
                        c.BackgroundTransparency = 0.5
                        c.BorderSizePixel = 2
                        c.Parent = sg
                        local corner = Instance.new("UICorner")
                        corner.CornerRadius = UDim.new(1, 0)
                        corner.Parent = c
                        HeadESPCircles[p] = c
                    end
                    c.Position = UDim2.new(0, pos.X - flags.HeadESPSize/2, 0, pos.Y - flags.HeadESPSize/2)
                    c.BackgroundColor3 = Color3.fromRGB(flags.HeadESPColor.R * 255, flags.HeadESPColor.G * 255, flags.HeadESPColor.B * 255)
                    c.Size = UDim2.new(0, flags.HeadESPSize, 0, flags.HeadESPSize)
                    c.Visible = true
                elseif HeadESPCircles[p] then
                    HeadESPCircles[p].Visible = false
                end
            end
        end
    end
end

