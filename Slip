RunService.RenderStepped:Connect(function()
    UpdateConfig()
    UpdateESPSettings()
    UpdateFOVCircle()
    UpdateTargetTracer()
    UpdateSelfESP()
    UpdateHeadESP()
    
    if Config.AimbotEnabled then
        local best = GetBestTarget()
        CurrentTarget = best
        if CurrentTarget and GetAngleToTarget(CurrentTarget) <= Config.FOV then
            AimAtTarget(CurrentTarget)
            DoAutoShoot()
        end
    else
