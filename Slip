-- Check Camera Perspective
local function CheckPerspective()
    if Aimbot.FirstPerson then
        return Camera.CameraType == Enum.CameraType.Custom
    elseif Aimbot.ThirdPerson then
        return Camera.CameraType ~= Enum.CameraType.Custom
    end
    return true
end

