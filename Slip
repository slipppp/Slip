            if coreLabel and coreLabel.Parent then
                local newHealthPercent = humanoid.Health / humanoid.MaxHealth
                local newHealthColor = Color3.fromRGB(255 * (1 - newHealthPercent), 255 * newHealthPercent, 0)
                coreLabel.Text = "❤️ " .. math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth)
                coreLabel.TextColor3 = newHealthColor
            end
        end)
    end
end

-- ========== CAMERA MODE FUNCTIONS ==========
local function UpdateCameraMode()
    local camera = workspace.CurrentCamera
    if not camera then return end
    
    if firstPersonOnly then
        camera.CameraType = Enum.CameraType.Attach
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            camera.CameraSubject = player.Character.Humanoid
        end
    elseif thirdPersonOnly then
        camera.CameraType = Enum.CameraType.Custom
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            local offset = Vector3.new(0, 3, 8)
            camera.CFrame = CFrame.new(hrp.Position + offset, hrp.Position)
        end
    else
        camera.CameraType = Enum.CameraType.Custom
    end
end

-- ========== AIMBOT FUNCTIONS ==========
local function GetClosestPlayerInFOV()
    local camera = workspace.CurrentCamera
    local character = player.Character
    if not character then return nil end
    
    local closest = nil
    local shortestDist = fovSize
    
    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= player and v.Character and v.Character:FindFirstChild(hitPart) then
            local humanoid = v.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local targetPos = v.Character[hitPart].Position
                
                -- Prediction
                if predictionAmount > 0 and v.Character:FindFirstChild("HumanoidRootPart") then
                    targetPos = targetPos + (v.Character.HumanoidRootPart.Velocity * predictionAmount)
                end
                
                local screenPos, onScreen = camera:WorldToScreenPoint(targetPos)
                
                if onScreen then
                    local dist = (Vector2.new(mouse.X, mouse.Y) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closest = v
                    end
                end
            end
        end
    end
    
    return closest
end

-- Shake value function - faz a mira tremer
local function ApplyShake(targetPos)
    if shakeValue <= 0 then return targetPos end
    
    shakeTimer = shakeTimer + 0.05
    local shakeX = math.sin(shakeTimer * 50) * shakeValue
    local shakeY = math.cos(shakeTimer * 47) * shakeValue
    local shakeZ = math.sin(shakeTimer * 53) * (shakeValue * 0.5)
    
    return targetPos + Vector3.new(shakeX, shakeY, shakeZ)
end

-- Dead zone check
local function IsOutsideDeadZone(currentPos, targetPos)
    if deadZone <= 0 then return true end
    local delta = (targetPos - currentPos).Magnitude
    return delta > deadZone
end

local function UpdateAimbot()
    if not aimbotEnabled then return end
    
    local target = GetClosestPlayerInFOV()
    if target then
        currentTarget = target
    end
    
    if currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChild(hitPart) then
        local targetPos = currentTarget.Character[hitPart].Position
        
        -- Prediction
        if predictionAmount > 0 and currentTarget.Character:FindFirstChild("HumanoidRootPart") then
            targetPos = targetPos + (currentTarget.Character.HumanoidRootPart.Velocity * predictionAmount)
        end
        
        -- Apply shake
        targetPos = ApplyShake(targetPos)
        
        local camera = workspace.CurrentCamera
        local screenPos = camera:WorldToScreenPoint(targetPos)
        
        local currentMousePos = Vector2.new(mouse.X, mouse.Y)
        local targetMousePos = Vector2.new(screenPos.X, screenPos.Y)
        
        -- Dead zone check
        if IsOutsideDeadZone(currentMousePos, targetMousePos) then
            -- Smoothness
            local newMousePos = currentMousePos:Lerp(targetMousePos, smoothness)
            local deltaX = newMousePos.X - currentMousePos.X
            local deltaY = newMousePos.Y - currentMousePos.Y
            
            if deltaX ~= 0 or deltaY ~= 0 then
                mousemoverel(deltaX, deltaY)
            end
        end
    end
end

-- ========== AUTO SHOOT FUNCTIONS ==========
local function AutoShoot()
    if not autoShootEnabled then return end
    
    if tick() - lastShootTime >= autoShootDelay then
        local target = GetClosestPlayerInFOV()
        if target and target.Character and target.Character:FindFirstChild(hitPart) then
            lastShootTime = tick()
            pcall(function()
                local vu = game:GetService("VirtualUser")
                vu:CaptureController()
                vu:ClickButton1(Vector2.new(0, 0))
            end)
        end
    end
end

-- ========== ANTI-AIM FUNCTIONS ==========
local function ApplyAntiAim()
    if not antiAimEnabled then return end
    
    local character = player.Character
    if not character then return end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")
    
    if not hrp then return end
    
    -- Yaw (Body)
    if yawMode == "Backwards" then
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(180), 0)
    elseif yawMode == "Sideways" then
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(90), 0)
    elseif yawMode == "Spin" then
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, tick() * 10, 0)
    elseif yawMode == "Jitter" then
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.sin(tick() * 30) * math.rad(90), 0)
    end
    
    -- Pitch (Head)
    if head then
        if pitchMode == "Up" then
            head.CFrame = head.CFrame * CFrame.Angles(math.rad(-90), 0, 0)
        elseif pitchMode == "Down" then
            head.CFrame = head.CFrame * CFrame.Angles(math.rad(90), 0, 0)
        elseif pitchMode == "Jitter" then
            head.CFrame = head.CFrame * CFrame.Angles(math.sin(tick() * 20) * math.rad(45), 0, 0)
        end
    end
end

local function StartAntiAimLoop()
    if antiAimConnection then antiAimConnection:Disconnect() end
    antiAimConnection = runService.RenderStepped:Connect(ApplyAntiAim)
end

local function StopAntiAimLoop()
    if antiAimConnection then
        antiAimConnection:Disconnect()
        antiAimConnection = nil
    end
end

-- ========== MOVEMENT FUNCTIONS ==========
local function StartFly()
    if flyEnabled or not player.Character then return end
    flyEnabled = true
    
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    flyBodyVelocity.Parent = hrp
    
    flyConnection = runService.RenderStepped:Connect(function()
        if not flyEnabled or not player.Character then
            if flyBodyVelocity then flyBodyVelocity:Destroy() end
            return
        end
        
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local moveDirection = Vector3.new()
        if userInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + Vector3.new(0, 0, -1) end
        if userInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection + Vector3.new(0, 0, 1) end
        if userInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection + Vector3.new(-1, 0, 0) end
        if userInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + Vector3.new(1, 0, 0) end
        if userInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0, 1, 0) end
        if userInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDirection = moveDirection + Vector3.new(0, -1, 0) end
        
        if moveDirection.Magnitude > 0 then
            flyBodyVelocity.Velocity = moveDirection.Unit * 100
        else
            flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
        end
    end)
end

local function StopFly()
    flyEnabled = false
    if flyBodyVelocity then flyBodyVelocity:Destroy() flyBodyVelocity = nil end
    if flyConnection then flyConnection:Disconnect() flyConnection = nil end
end

local function StartNoclip()
    if noclipEnabled then return end
    noclipEnabled = true
    
    noclipConnection = runService.Stepped:Connect(function()
        if not noclipEnabled or not player.Character then return end
        for _, part in pairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)
end

local function StopNoclip()
    noclipEnabled = false
    if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
    if player.Character then
        for _, part in pairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end

local function StartBHop()
    if bhopEnabled then return end
    bhopEnabled = true
    
    bhopConnection = runService.RenderStepped:Connect(function()
        if not bhopEnabled or not player.Character then return end
        local humanoid = player.Character:FindFirstChild("Humanoid")
        if humanoid and humanoid.FloorMaterial ~= Enum.Material.Air and userInputService:IsKeyDown(Enum.KeyCode.Space) then
            humanoid.Jump = true
        end
    end)
end

local function StopBHop()
    bhopEnabled = false
    if bhopConnection then bhopConnection:Disconnect() bhopConnection = nil end
end

-- ========== PLAYERS FUNCTIONS ==========
local function UpdatePlayerList(dropdown)
    local players = {}
    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= player then
            table.insert(players, v.Name)
        end
    end
    if dropdown then
        dropdown:SetItems(players)
    end
    return players
end

-- ========== MAIN RENDER LOOP ==========
runService.RenderStepped:Connect(function()
    -- Aimbot
    UpdateAimbot()
    
    -- Auto Shoot
    AutoShoot()
    
    -- ESP
    if ESP then
        ESP.Enabled = espEnabled
    end
    
    -- Self ESP
    UpdateSelfESP()
    
    -- Camera Mode
    UpdateCameraMode()
end)

-- ========== CHARACTER RESPAWN HANDLER ==========
player.CharacterAdded:Connect(function(char)
    wait(0.5)
    
    -- Restore speed and jump
    if currentSpeed ~= 16 and char:FindFirstChild("Humanoid") then
        char.Humanoid.WalkSpeed = currentSpeed
    end
    if currentJumpPower ~= 50 and char:FindFirstChild("Humanoid") then
        char.Humanoid.JumpPower = currentJumpPower
    end
    
    -- Restore movement toggles
    if flyEnabled then StartFly() end
    if noclipEnabled then StartNoclip() end
    if bhopEnabled then StartBHop() end
    if antiAimEnabled then StartAntiAimLoop() end
    
    wait(0.5)
    UpdateSelfESP()
end)

