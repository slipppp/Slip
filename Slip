    if f.BoxOutlineColor then ESP.BoxOutlineColor = Color3.fromRGB(f.BoxOutlineColor.R * 255, f.BoxOutlineColor.G * 255, f.BoxOutlineColor.B * 255) end
    if f.NameColor then ESP.NameColor = Color3.fromRGB(f.NameColor.R * 255, f.NameColor.G * 255, f.NameColor.B * 255) end
    if f.HealthHighColor then ESP.HealthHighColor = Color3.fromRGB(f.HealthHighColor.R * 255, f.HealthHighColor.G * 255, f.HealthHighColor.B * 255) end
    if f.HealthLowColor then ESP.HealthLowColor = Color3.fromRGB(f.HealthLowColor.R * 255, f.HealthLowColor.G * 255, f.HealthLowColor.B * 255) end
    if f.TracerColor then ESP.TracerColor = Color3.fromRGB(f.TracerColor.R * 255, f.TracerColor.G * 255, f.TracerColor.B * 255) end
end

