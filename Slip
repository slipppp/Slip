-- Helper Functions
local function GetCharacter(Player)
    return Player.Character
end

local function GetHumanoid(Player)
    local Char = GetCharacter(Player)
    return Char and Char:FindFirstChild("Humanoid")
end

local function GetPart(Player, PartName)
    local Char = GetCharacter(Player)
    return Char and Char:FindFirstChild(PartName)
end

local function IsAlive(Player)
    local Humanoid = GetHumanoid(Player)
    return Humanoid and Humanoid.Health > 0
end

local function IsTeammate(Player)
    if not Aimbot.TeamCheck then return false end
    return LocalPlayer.Team and Player.Team == LocalPlayer.Team
end

local function GetDistance(Part1, Part2)
    return (Part1.Position - Part2.Position).Magnitude
end

local function GetViewportCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

local function WorldToScreen(Point)
    local Vec, OnScreen = Camera:WorldToScreenPoint(Point)
    return Vector2.new(Vec.X, Vec.Y), OnScreen
end

-- Get Correct Hit Part (Normal or Air)
local function GetTargetPart(Target)
    local Char = GetCharacter(Target)
    if not Char then return nil end
    
    local Humanoid = GetHumanoid(Target)
    local IsJumping = Humanoid and (Humanoid:GetState() == Enum.HumanoidStateType.Jumping or Humanoid:GetState() == Enum.HumanoidStateType.Freefall)
    
    local PartName = Aimbot.HitPart
    if IsJumping then
        PartName = Aimbot.AirPart
    end
    
    local Part = GetPart(Target, PartName)
    if not Part then
        Part = GetPart(Target, "HumanoidRootPart")
    end
    
    return Part
end

-- Calculate Angle to Target (distance from center in pixels)
local function GetAngleToTarget(Target)
    local TargetPart = GetTargetPart(Target)
    if not TargetPart then return math.huge end
    
    local ScreenPos, OnScreen = WorldToScreen(TargetPart.Position)
    if not OnScreen then return math.huge end
    
    local Center = GetViewportCenter()
    return (ScreenPos - Center).Magnitude
end

-- Calculate Dynamic FOV based on distance
local function GetDynamicFOV(Target)
    if not Aimbot.DynamicFOV then return Aimbot.FOV end
    
    local TargetPart = GetTargetPart(Target)
    local LocalPart = GetCharacter(LocalPlayer) and GetCharacter(LocalPlayer):FindFirstChild("HumanoidRootPart")
    
    if not TargetPart or not LocalPart then return Aimbot.FOV end
    
    local Distance = GetDistance(TargetPart, LocalPart)
    local DynamicValue = Aimbot.FOV * (1 - math.min(Distance / 500, 0.7))
    return math.clamp(DynamicValue, 30, Aimbot.FOV)
end

-- Prediction Logic
local function PredictPosition(Target, CurrentPos)
    if not Aimbot.Prediction then return CurrentPos end
    
    local RootPart = GetPart(Target, "HumanoidRootPart")
    if not RootPart then return CurrentPos end
    
    local Velocity = RootPart.Velocity
    if Velocity.Magnitude < 0.1 then return CurrentPos end
    
    local LocalPart = GetCharacter(LocalPlayer) and GetCharacter(LocalPlayer):FindFirstChild("HumanoidRootPart")
    if not LocalPart then return CurrentPos end
    
    local Distance = GetDistance(CurrentPos, LocalPart.Position)
    local BulletSpeed = 3000
    local TravelTime = Distance / BulletSpeed
    
    local Strength = Aimbot.PredictStrength / 100
    
    if Aimbot.PredictMethod == "Velocity" then
        TravelTime = TravelTime * (Velocity.Magnitude / 50)
    elseif Aimbot.PredictMethod == "Distance Based" then
        TravelTime = TravelTime * (Distance / 100)
    elseif Aimbot.PredictMethod == "Smart" then
        local SpeedFactor = math.clamp(Velocity.Magnitude / 100, 0.5, 2)
        TravelTime = TravelTime * SpeedFactor
    end
    
    if Aimbot.SmartPredict then
        local SpeedFactor = 1 + (Velocity.Magnitude / 150)
        TravelTime = TravelTime * SpeedFactor
    end
    
    TravelTime = TravelTime * Strength
    TravelTime = math.min(TravelTime, 0.3)
    
    return CurrentPos + (Velocity * TravelTime)
end

-- Apply Shake to aim
local function ApplyShake()
    if Aimbot.ShakeValue <= 0 then return Vector2.zero end
    
    local ShakeX = (math.random() - 0.5) * Aimbot.ShakeValue * 2
    local ShakeY = (math.random() - 0.5) * Aimbot.ShakeValue * 2
    return Vector2.new(ShakeX, ShakeY)
end

-- Apply Stabilization (smooths out jitter)
local function ApplyStabilization(CurrentAngle, TargetAngle)
    if not Aimbot.Stabilization then return TargetAngle end
    
    local Diff = TargetAngle - CurrentAngle
    local Strength = Aimbot.StabilizationValue / 100
    
    if math.abs(Diff) < 5 then
        return CurrentAngle + (Diff * Strength)
    end
    
    return TargetAngle
end

-- Get Best Target (closest to crosshair)
local function GetBestTarget()
    local BestTarget = nil
    local BestAngle = Aimbot.FOV
    local CurrentFOV = Aimbot.FOV
    
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and IsAlive(Player) and not IsTeammate(Player) then
            local Angle = GetAngleToTarget(Player)
            local MaxAngle = CurrentFOV
            
            if Aimbot.DynamicFOV then
                MaxAngle = GetDynamicFOV(Player)
            end
            
            if Angle < MaxAngle and Angle < BestAngle then
                BestAngle = Angle
                BestTarget = Player
            end
        end
    end
    
    return BestTarget, BestAngle
end

-- Aim at Target (Camera manipulation)
local function AimAtTarget(Target)
    local TargetPart = GetTargetPart(Target)
    if not TargetPart then return end
    
    local TargetPos = TargetPart.Position
    
    -- Apply Prediction
    if Aimbot.Prediction then
        TargetPos = PredictPosition(Target, TargetPos)
    end
    
    -- Apply Shake
    local Shake = ApplyShake()
    TargetPos = TargetPos + Vector3.new(Shake.X, Shake.Y, 0)
    
    local CurrentCF = Camera.CFrame
    local TargetCF = CFrame.lookAt(CurrentCF.Position, TargetPos)
    
    local CurrentLook = CurrentCF.LookVector
    local TargetLook = TargetCF.LookVector
    local AngleDiff = math.deg(math.acos(math.clamp(CurrentLook:Dot(TargetLook), -1, 1)))
    
    -- Apply Deadzone
    if AngleDiff < Aimbot.Deadzone then
        return
    end
    
    -- Apply Stabilization
    local StabilizedAngle = ApplyStabilization(AngleDiff, AngleDiff)
    
    -- Apply Smoothness
    local SmoothX = Aimbot.BlatantMode and 1 or Aimbot.SmoothnessX
    local SmoothY = Aimbot.BlatantMode and 1 or Aimbot.SmoothnessY
    local Alpha = math.min(1, (SmoothX + SmoothY) / 20)
    
    if Aimbot.BlatantMode then
        -- Instant aim
        Camera.CFrame = TargetCF
    else
        -- Smooth aim
        local NewCF = CurrentCF:Lerp(TargetCF, Alpha / 10)
        Camera.CFrame = NewCF
    end
end

-- Flick Bot Logic
local function FlickToTarget(Target)
    local TargetPart = GetTargetPart(Target)
    if not TargetPart then return end
    
    local TargetPos = TargetPart.Position
    local CurrentCF = Camera.CFrame
    local TargetCF = CFrame.lookAt(CurrentCF.Position, TargetPos)
    
    local FlickSteps = math.max(1, math.floor(101 - Aimbot.FlickSpeed))
    
    for i = 1, FlickSteps do
        local Alpha = i / FlickSteps
        Camera.CFrame = CurrentCF:Lerp(TargetCF, Alpha)
        RunService.RenderStepped:Wait()
    end
    
    if Aimbot.FlickAutoShoot then
        local Tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Tool")
        if Tool then
            Tool:Activate()
        end
    end
end

-- Auto Shoot
local function DoAutoShoot()
    if not Aimbot.AutoShoot then return end
    if not CurrentTarget then return end
    
    local Angle = GetAngleToTarget(CurrentTarget)
    local MaxAngle = Aimbot.DynamicFOV and GetDynamicFOV(CurrentTarget) or Aimbot.FOV
    
    if Angle <= MaxAngle then
        local Tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Tool")
        if Tool then
            Tool:Activate()
        end
    end
end

-- Create FOV Circle
local function CreateFOVCircle()
    if FOVCircle then
        FOVCircle:Destroy()
    end
    
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "FOVCircleGUI"
    ScreenGui.Parent = game:GetService("CoreGui")
    
    FOVCircle = Instance.new("Frame")
    FOVCircle.Size = UDim2.new(0, Aimbot.FOV * 2, 0, Aimbot.FOV * 2)
    FOVCircle.Position = UDim2.new(0.5, -Aimbot.FOV, 0.5, -Aimbot.FOV)
    FOVCircle.BackgroundTransparency = 1
    FOVCircle.BorderSizePixel = 2
    FOVCircle.Parent = ScreenGui
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(1, 0)
    Corner.Parent = FOVCircle
end

-- Update FOV Circle
local function UpdateFOVCircle()
    if not FOVCircle then return end
    
    if Aimbot.ShowFOV then
        FOVCircle.Parent.Enabled = true
        local CurrentFOV = Aimbot.FOV
        
        if Aimbot.DynamicFOV and CurrentTarget then
            CurrentFOV = GetDynamicFOV(CurrentTarget)
        end
        
        FOVCircle.Size = UDim2.new(0, CurrentFOV * 2, 0, CurrentFOV * 2)
        FOVCircle.Position = UDim2.new(0.5, -CurrentFOV, 0.5, -CurrentFOV)
        FOVCircle.BorderColor3 = Aimbot.FOVColor
    else
        if FOVCircle then
            FOVCircle.Parent.Enabled = false
        end
    end
end

-- Create Head ESP (2D Circle)
local function UpdateHeadESP()
    if not Aimbot.HeadESP then
        for _, Circle in pairs(HeadESPCircles) do
            Circle:Destroy()
        end
        HeadESPCircles = {}
        return
    end
    
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and IsAlive(Player) and not IsTeammate(Player) then
            local Head = GetPart(Player, "Head")
            if Head then
                local ScreenPos, OnScreen = WorldToScreen(Head.Position)
                if OnScreen then
                    local Circle = HeadESPCircles[Player]
                    if not Circle then
                        local ScreenGui = Instance.new("ScreenGui")
                        ScreenGui.Name = "HeadESP_" .. Player.Name
                        ScreenGui.Parent = game:GetService("CoreGui")
                        
                        Circle = Instance.new("Frame")
                        Circle.Size = UDim2.new(0, Aimbot.HeadESPSize, 0, Aimbot.HeadESPSize)
                        Circle.BackgroundColor3 = Aimbot.HeadESPColor
                        Circle.BackgroundTransparency = 0.5
                        Circle.BorderSizePixel = 2
                        Circle.Parent = ScreenGui
                        
                        local Corner = Instance.new("UICorner")
                        Corner.CornerRadius = UDim.new(1, 0)
                        Corner.Parent = Circle
                        
                        HeadESPCircles[Player] = {Circle = Circle, Gui = ScreenGui}
                    end
                    
                    HeadESPCircles[Player].Circle.Position = UDim2.new(0, ScreenPos.X - Aimbot.HeadESPSize/2, 0, ScreenPos.Y - Aimbot.HeadESPSize/2)
                    HeadESPCircles[Player].Circle.BackgroundColor3 = Aimbot.HeadESPColor
                    HeadESPCircles[Player].Circle.Size = UDim2.new(0, Aimbot.HeadESPSize, 0, Aimbot.HeadESPSize)
                elseif HeadESPCircles[Player] then
                    HeadESPCircles[Player].Circle.Visible = false
                end
            end
        end
    end
end

-- Create ESP Box
local function UpdateESPBoxes()
    if not Aimbot.ESP or not Aimbot.ShowBox then
        for _, Box in pairs(ESPBoxes) do
            Box:Destroy()
        end
        ESPBoxes = {}
        return
    end
    
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and IsAlive(Player) and not IsTeammate(Player) then
            local RootPart = GetPart(Player, "HumanoidRootPart") or GetPart(Player, "Torso")
            if RootPart then
                local Box = ESPBoxes[Player]
                if not Box then
                    Box = Instance.new("BoxHandleAdornment")
                    Box.AlwaysOnTop = true
                    Box.ZIndex = 10
                    Box.Parent = GetCharacter(Player)
                    ESPBoxes[Player] = Box
                end
                Box.Adornee = RootPart
                Box.Size = Vector3.new(3, 5, 2)
                Box.Color3 = Aimbot.BoxColor
                Box.Transparency = 0.5
                Box.Visible = true
            end
        elseif ESPBoxes[Player] then
            ESPBoxes[Player].Visible = false
        end
    end
end

-- Create Name Tags (with Health and Distance)
local function UpdateNameTags()
    if not Aimbot.ESP or (not Aimbot.ShowName and not Aimbot.ShowHealth and not Aimbot.ShowDistance) then
        for _, Tag in pairs(ESPNameTags) do
            Tag:Destroy()
        end
        ESPNameTags = {}
        return
    end
    
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and IsAlive(Player) and not IsTeammate(Player) then
            local RootPart = GetPart(Player, "HumanoidRootPart") or GetPart(Player, "Torso")
            if RootPart then
                local Tag = ESPNameTags[Player]
                if not Tag then
                    local Billboard = Instance.new("BillboardGui")
                    Billboard.Size = UDim2.new(0, 120, 0, 40)
                    Billboard.Adornee = RootPart
                    Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                    Billboard.AlwaysOnTop = true
                    Billboard.Parent = GetCharacter(Player)
                    
                    local NameLabel = Instance.new("TextLabel")
                    NameLabel.Size = UDim2.new(1, 0, 0.6, 0)
                    NameLabel.BackgroundTransparency = 1
                    NameLabel.TextColor3 = Aimbot.NameColor
                    NameLabel.TextStrokeTransparency = 0.3
                    NameLabel.TextScaled = true
                    NameLabel.Font = Enum.Font.GothamBold
                    NameLabel.Parent = Billboard
                    
                    local HealthBar = Instance.new("Frame")
                    HealthBar.Size = UDim2.new(1, 0, 0.25, 0)
                    HealthBar.Position = UDim2.new(0, 0, 0.7, 0)
                    HealthBar.BackgroundColor3 = Aimbot.HealthHighColor
                    HealthBar.Parent = Billboard
                    
                    local HealthCorner = Instance.new("UICorner")
                    HealthCorner.CornerRadius = UDim.new(1, 0)
                    HealthCorner.Parent = HealthBar
                    
                    ESPNameTags[Player] = {Billboard = Billboard, NameLabel = NameLabel, HealthBar = HealthBar}
                end
                
                local Humanoid = GetHumanoid(Player)
                local Health = Humanoid and Humanoid.Health or 100
                local MaxHealth = Humanoid and Humanoid.MaxHealth or 100
                local HealthPercent = Health / MaxHealth
                
                local Text = ""
                if Aimbot.ShowName then
                    Text = Player.Name
                end
                if Aimbot.ShowDistance then
                    local LocalRoot = GetCharacter(LocalPlayer) and GetCharacter(LocalPlayer):FindFirstChild("HumanoidRootPart")
                    if LocalRoot then
                        local Distance = GetDistance(RootPart, LocalRoot)
                        Text = Text .. (Text ~= "" and " | " or "") .. math.floor(Distance) .. "m"
                    end
                end
                
                ESPNameTags[Player].NameLabel.Text = Text
                ESPNameTags[Player].NameLabel.TextColor3 = Aimbot.NameColor
                
                if Aimbot.ShowHealth then
                    ESPNameTags[Player].HealthBar.Visible = true
                    ESPNameTags[Player].HealthBar.Size = UDim2.new(HealthPercent, 0, 0.25, 0)
                    if HealthPercent < 0.3 then
                        ESPNameTags[Player].HealthBar.BackgroundColor3 = Aimbot.HealthLowColor
                    elseif HealthPercent < 0.6 then
                        ESPNameTags[Player].HealthBar.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
                    else
                        ESPNameTags[Player].HealthBar.BackgroundColor3 = Aimbot.HealthHighColor
                    end
                else
                    ESPNameTags[Player].HealthBar.Visible = false
                end
                
                ESPNameTags[Player].Billboard.Enabled = true
            end
        elseif ESPNameTags[Player] then
            ESPNameTags[Player].Billboard.Enabled = false
        end
    end
end

