-- Rainbow color function
local function rainbowColor()
    local time = tick() * 3
    return Color3.new(math.sin(time), math.sin(time + 2), math.sin(time + 4))
end

-- Update highlight colors
local function UpdateHighlightColors()
    for player, highlight in pairs(PlayerHighlights) do
        if highlight and highlight.Parent then
            if Config.RainbowESP then
                highlight.OutlineColor = rainbowColor()
            else
                highlight.OutlineColor = Config.OutlineColor
            end
            highlight.FillColor = Config.FillColor
            highlight.FillTransparency = Config.FillTransparency
            highlight.Enabled = Config.ESPEnable
        end
    end
end

-- Create highlight for a player
local function CreateHighlight(player)
    if player == LocalPlayer then return end
    
    local highlight = Instance.new("Highlight")
    highlight.OutlineColor = Config.OutlineColor
    highlight.FillColor = Config.FillColor
    highlight.FillTransparency = Config.FillTransparency
    highlight.OutlineTransparency = 0
    highlight.Enabled = Config.ESPEnable
    
    if player.Character then
        highlight.Parent = player.Character
    end
    
    player.CharacterAdded:Connect(function(character)
        highlight.Parent = character
    end)
    
    PlayerHighlights[player] = highlight
end

-- Remove highlight
local function RemoveHighlight(player)
    if PlayerHighlights[player] then
        PlayerHighlights[player]:Destroy()
        PlayerHighlights[player] = nil
    end
end

-- Update all highlights
local function UpdateHighlights()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if Config.ESPEnable then
                if not PlayerHighlights[player] then
                    CreateHighlight(player)
                end
            else
                RemoveHighlight(player)
            end
        end
    end
end

-- ============================================
-- ANTI-AIM FUNCTIONS
-- ============================================
local function GetTargetDirection()
    if CurrentTarget and CurrentTarget.Character then
        local targetPart = CurrentTarget.Character:FindFirstChild("HumanoidRootPart") or CurrentTarget.Character:FindFirstChild("Torso") or CurrentTarget.Character:FindFirstChild("UpperTorso")
        if targetPart then
            return (targetPart.Position - Camera.CFrame.Position).Unit
        end
    end
    return nil
end

local function UpdateAntiAim()
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    -- PITCH (Olhar para cima/baixo)
    if Config.PitchEnabled then
        local pitch = 0
        local mode = Config.PitchMode
        
        if mode == "Up" then
            pitch = -90
        elseif mode == "Down" then
            pitch = 90
        elseif mode == "Random" then
            pitch = math.random(-90, 90)
        elseif mode == "Jitter" then
            JitterTimer = JitterTimer + (Config.PitchSpeed / 10)
            pitch = math.sin(JitterTimer) * Config.PitchJitter
        elseif mode == "None" then
            pitch = 0
        end
        
        -- Aplicar pitch na câmera ou no personagem
        local currentCF = character:GetPivot()
        local lookVector = currentCF.LookVector
        local newCF = CFrame.new(currentCF.Position, currentCF.Position + lookVector) * CFAngle(math.rad(pitch), 0, 0)
        character:SetPrimaryPartCFrame(newCF)
    end
    
    -- YAW (Rotação do corpo)
    if Config.YawEnabled then
        local yaw = 0
        local mode = Config.YawMode
        
        if mode == "Backwards" then
            yaw = 180
        elseif mode == "Sideways" then
            yaw = 90
        elseif mode == "Random" then
            yaw = math.random(0, 360)
        elseif mode == "Spin Bot" then
            SpinAngle = SpinAngle + (Config.SpinSpeed / 60)
            if SpinAngle > 360 then SpinAngle = SpinAngle - 360 end
            yaw = SpinAngle
        elseif mode == "Target" then
            local targetDir = GetTargetDirection()
            if targetDir then
                local targetAngle = math.deg(math.atan2(targetDir.X, targetDir.Z))
                yaw = targetAngle + 180
            end
        elseif mode == "Jitter" then
            JitterTimer = JitterTimer + (Config.PitchSpeed / 10)
            yaw = math.sin(JitterTimer) * Config.YawJitter
        elseif mode == "None" then
            yaw = 0
        end
        
        yaw = yaw + Config.YawOffset
        
        -- Aplicar yaw na câmera ou no personagem
        local currentCF = character:GetPivot()
        local newCF = CFrame.new(currentCF.Position) * CFrame.Angles(0, math.rad(yaw), 0)
        character:SetPrimaryPartCFrame(newCF)
    end
end

-- Helper CFrame.Angles
local function CFAngle(x, y, z)
    return CFrame.Angles(x, y, z)
end

-- SUPORTE R15 E R6
local function GetPart(p, partName)
    local c = p.Character
    if not c then return nil end
    
    local mapping = {
        Head = {"Head"},
        Torso = {"Torso", "UpperTorso"},
        HumanoidRootPart = {"HumanoidRootPart"},
        ["Left Arm"] = {"Left Arm", "LeftHand"},
        ["Right Arm"] = {"Right Arm", "RightHand"},
        ["Left Leg"] = {"Left Leg", "LeftFoot"},
        ["Right Leg"] = {"Right Leg", "RightFoot"}
    }
    
    local names = mapping[partName] or {partName}
    for _, name in ipairs(names) do
        local part = c:FindFirstChild(name)
        if part then return part end
    end
    return nil
end

local function GetCharacter(p) return p.Character end
local function GetHumanoid(p) local c = GetCharacter(p) return c and c:FindFirstChild("Humanoid") end
local function IsAlive(p) local h = GetHumanoid(p) return h and h.Health > 0 end

local function IsTeammate(p)
    if not Config.TeamCheck then return false end
    return LocalPlayer.Team and p.Team == LocalPlayer.Team
end

local function IsVisible(part)
    if not Config.WallCheck then return true end
    local origin = Camera.CFrame.Position
    local dir = (part.Position - origin).Unit
    local ray = Ray.new(origin, dir * (part.Position - origin).Magnitude)
    local hit, pos = workspace:FindPartOnRay(ray, LocalPlayer.Character)
    return hit == part or hit == nil
end

local function IsJumping(p)
    local h = GetHumanoid(p)
    if not h then return false end
    local s = h:GetState()
    return s == Enum.HumanoidStateType.Jumping or s == Enum.HumanoidStateType.Freefall
end

local function GetDistance(p1, p2)
    return (p1.Position - p2.Position).Magnitude
end

local function GetTargetPart(t)
    local name = Config.HitPart
    if IsJumping(t) and Config.AirPart ~= "None" then
        name = Config.AirPart
    end
    local p = GetPart(t, name) or GetPart(t, "HumanoidRootPart") or GetPart(t, "Torso") or GetPart(t, "UpperTorso")
    return p
end

local function WorldToScreen(pos)
    local v, on = Camera:WorldToScreenPoint(pos)
    return Vector2.new(v.X, v.Y), on
end

local function GetViewportCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

local function GetAngleToTarget(t)
    local p = GetTargetPart(t)
    if not p then return math.huge end
    local pos, on = WorldToScreen(p.Position)
    if not on then return math.huge end
    return (pos - GetViewportCenter()).Magnitude
end

local function GetDistanceToTarget(t)
    local p = GetTargetPart(t)
    local lp = GetPart(LocalPlayer, "HumanoidRootPart") or GetPart(LocalPlayer, "Torso") or GetPart(LocalPlayer, "UpperTorso")
    if not p or not lp then return 9999 end
    return (p.Position - lp.Position).Magnitude
end

-- FOV Circle
local function CreateFOVCircle()
    if FOVCircle then FOVCircle:Destroy() end
    local sg = Instance.new("ScreenGui")
    sg.Name = "FOVCircle"
    sg.Parent = game:GetService("CoreGui")
