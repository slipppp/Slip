        headGui.Name = "SelfESP_Head"
        headGui.Adornee = head
        headGui.Size = UDim2.new(0, 180, 0, 60)
        headGui.StudsOffset = Vector3.new(0, 1.5, 0)
        headGui.AlwaysOnTop = true
        headGui.Parent = head
        
        local headLabel = Instance.new("TextLabel")
        headLabel.Size = UDim2.new(1, 0, 1, 0)
        headLabel.BackgroundTransparency = 1
        headLabel.Text = player.Name .. " (YOU)"
        headLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
        headLabel.TextStrokeTransparency = 0.2
        headLabel.Font = Enum.Font.GothamBold
        headLabel.TextSize = 16
        headLabel.Parent = headGui
        
        selfESPObjects["Head"] = headGui
    end
    
    if core and not selfESPObjects["Core"] then
        local coreGui = Instance.new("BillboardGui")
        coreGui.Name = "SelfESP_Core"
        coreGui.Adornee = core
        coreGui.Size = UDim2.new(0, 140, 0, 45)
        coreGui.StudsOffset = Vector3.new(0, 0, 0)
        coreGui.AlwaysOnTop = true
        coreGui.Parent = core
        
        local healthPercent = humanoid.Health / humanoid.MaxHealth
        local healthColor = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
        
        local coreLabel = Instance.new("TextLabel")
        coreLabel.Size = UDim2.new(1, 0, 1, 0)
        coreLabel.BackgroundTransparency = 1
        coreLabel.Text = "❤️ " .. math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth)
        coreLabel.TextColor3 = healthColor
        coreLabel.TextStrokeTransparency = 0.2
        coreLabel.Font = Enum.Font.GothamBold
        coreLabel.TextSize = 14
        coreLabel.Parent = coreGui
        
