-- Flick Bot Key Check
local function CheckFlickKey()
    if not Aimbot.FlickBot then return end
    
    local KeyDown = false
    if type(Aimbot.FlickKey) == "number" then
        KeyDown = UserInputService:IsKeyDown(Enum.KeyCode[Aimbot.FlickKey])
    end
    
    if KeyDown and not FlickActive then
        FlickActive = true
        local BestTarget, BestAngle = GetBestTarget()
        if BestTarget and BestAngle <= Aimbot.FlickFOV then
            FlickToTarget(BestTarget)
        end
    elseif not KeyDown then
        FlickActive = false
    end
end

-- Initialize
local function Initialize()
    CreateFOVCircle()
    
    RunService.RenderStepped:Connect(function()
        UpdateSettings()
        CheckPerspective()
        CheckFlickKey()
        UpdateFOVCircle()
        UpdateHeadESP()
        UpdateESPBoxes()
        UpdateNameTags()
        UpdateGroundTracers()
        UpdateTargetTracer()
        UpdateSelfESP()
        
        if not CheckPerspective() then
            CurrentTarget = nil
            return
        end
        
        if Aimbot.Enabled then
            local BestTarget, BestAngle = GetBestTarget()
            
            if Aimbot.AutoLock and CurrentTarget and IsAlive(CurrentTarget) then
                BestTarget = CurrentTarget
            else
                CurrentTarget = BestTarget
            end
            
            if CurrentTarget then
                local Angle = GetAngleToTarget(CurrentTarget)
                local MaxAngle = Aimbot.DynamicFOV and GetDynamicFOV(CurrentTarget) or Aimbot.FOV
                
                if Angle <= MaxAngle then
                    AimAtTarget(CurrentTarget)
                    DoAutoShoot()
                end
            end
        else
            CurrentTarget = nil
        end
    end)
end

Initialize()

