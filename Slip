-- Main Loop
RunService.RenderStepped:Connect(function()
    UpdateConfig()
    UpdateESPSettings()
    UpdateFOVCircle()
    UpdateSelfESP()
    UpdateHeadESP()
    UpdateTargetTracer()
    
    if not CheckPerspective() then
        CurrentTarget = nil
        return
    end
    
    if Config.AimbotEnabled then
        local best = GetBestTarget()
        if Config.StickyAim and CurrentTarget and IsAlive(CurrentTarget) then
            best = CurrentTarget
        else
            CurrentTarget = best
        end
        if CurrentTarget and GetAngleToTarget(CurrentTarget) <= Config.FOV then
            AimAtTarget(CurrentTarget)
        end
    else
        CurrentTarget = nil
    end
end)

