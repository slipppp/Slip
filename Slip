-- Update Target Tracer (Line from center to target)
local function UpdateTargetTracer()
    if not Aimbot.ShowTargetTracer or not CurrentTarget then
        if TargetLine then
            TargetLine:Destroy()
            TargetLine = nil
        end
        return
    end
    
    local TargetPart = GetTargetPart(CurrentTarget)
    if not TargetPart then return end
    
    local ScreenPos, OnScreen = WorldToScreen(TargetPart.Position)
    if not OnScreen then return end
    
    local Center = GetViewportCenter()
    
    local Success, NewLine = pcall(function()
        if TargetLine then
            TargetLine:Destroy()
        end
        local Line = Drawing.new("Line")
        Line.From = Center
        Line.To = ScreenPos
        Line.Color = Aimbot.TracerColor
        Line.Thickness = 2
        Line.Transparency = 0.7
        Line.Visible = true
        return Line
    end)
    
    if Success then
        TargetLine = NewLine
    end
end

